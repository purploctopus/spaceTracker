# --- Xcode ---
# User-specific Xcode files (keeps your layout from overwriting others)
*.xcuserstate
*.xcuserdatad
xcuserdata/

# Build artifacts and derived data
build/
DerivedData/
*.moved-aside
*.xccheckout
*.plugins

# --- Swift Package Manager ---
# Ignore the build directory generated by SPM
.build/
# Only un-comment the line below if you want to lock your dependencies manually
# Package.resolved

# --- CocoaPods (If you use it) ---
# Ignore the Pods directory unless you intentionally want to check it in
Pods/
*.xcworkspace

# --- Carthage (If you use it) ---
Carthage/Build/

# --- Fastlane (If you use automated deployment) ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# --- Security & Environment Variables ---
# Ignore keys, certificates, and local configurations
*.env
*.env.*
*.plist.local
*.p12
*.pem

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
